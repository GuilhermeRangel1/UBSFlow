    "Audience": "UBSFlow.Api",
    "Secret": "UBSFlow-chave-local-de-desenvolvimento-com-mais-de-32-caracteres",
    "ExpiracaoMinutos": 120
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
